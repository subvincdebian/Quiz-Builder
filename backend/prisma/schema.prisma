generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  createdAt DateTime   @default(now())
  questions Question[]

  @@index([title])
  @@index([createdAt])
}

model Question {
  id             String   @id @default(uuid())
  type           String
  text           String
  options        String[]
  correctAnswers String[]
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
