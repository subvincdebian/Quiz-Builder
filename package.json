{
  "name": "quiz-builder",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "npm run lint:fix -w backend && npm run lint:fix -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:cov": "npm run test:cov -w backend && npm run test:cov -w frontend",
    "test:e2e": "npm run test:e2e -w backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "release": "standard-version",
    "adr": "node scripts/new-adr.mjs",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.0.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/platform-express": "^11.1.28"
  }
}
